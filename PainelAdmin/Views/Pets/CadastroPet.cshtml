@model PainelAdmin.Models.Pet

@{
    ViewData["Title"] = "Cadastrar Pet";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@section Styles {
    <link rel="stylesheet" href="~/css/site/style_cadastro.css" asp-append-version="true" />
}

<div class="form-container">
    <form id="petForm" asp-action="Create" enctype="multipart/form-data">
        <h2 class="form-title">Cadastro de Pet</h2>

        <div class="steps">
            <div class="step active">1</div>
            <div class="step">2</div>
        </div>

        <!-- Etapa 1 -->
        <div class="step-content active">
            <label asp-for="Nome">Nome:</label>
            <input asp-for="Nome" placeholder="Nome do pet" required />

            <label asp-for="Idade">Idade:</label>
            <input asp-for="Idade" placeholder="Idade aproximada" required />

            <label asp-for="Especie">Espécie:</label>
            <select asp-for="Especie">
                <option value="">Selecione</option>
                <option>Cachorro</option>
                <option>Gato</option>
            </select>

            <label asp-for="Sexo">Sexo:</label>
            <select asp-for="Sexo">
                <option value="">Selecione</option>
                <option>Macho</option>
                <option>Fêmea</option>
            </select>

            

            <div class="form-navigation align-right">
                <button type="button" class="btn-next" onclick="nextPrev(1)">Próximo</button>
            </div>
        </div>

        <!-- Etapa 2 -->
        <div class="step-content">
            <label asp-for="Porte">Porte:</label>
            <select asp-for="Porte">
                <option value="">Selecione</option>
                <option>Pequeno</option>
                <option>Médio</option>
                <option>Grande</option>
            </select>

            <label asp-for="Peso">Peso:</label>
            <input asp-for="Peso" placeholder="Peso do pet em kg" required />

            <label asp-for="Raca">Raça:</label>
            <input asp-for="Raca" placeholder="Raça do pet" />

            <label asp-for="Cor">Cor:</label>
            <input asp-for="Cor" placeholder="Cor predominante" />
            <label>Imagem do Pet:</label>
            <input type="file" name="Imagem" accept="image/*" onchange="previewImage(event)" />

            <div class="image-preview mt-3">
                <img id="imagePreview" src="#" style="display: none;" />
            </div>

            <input type="hidden" asp-for="Situacao" />

            <div class="form-navigation">
                <button type="button" class="btn-back" onclick="nextPrev(-1)">Voltar</button>
                <button type="submit" class="btn-submit">Cadastrar</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        let currentStep = 0;
        showStep(currentStep);

        function showStep(n) {
            let steps = document.getElementsByClassName("step-content");
            let indicators = document.getElementsByClassName("step");
            for (let i = 0; i < steps.length; i++) {
                steps[i].classList.remove("active");
                indicators[i].classList.remove("active");
            }
            steps[n].classList.add("active");
            indicators[n].classList.add("active");
        }

        function nextPrev(n) {
            let steps = document.getElementsByClassName("step-content");
            currentStep += n;
            if (currentStep >= steps.length) currentStep = steps.length - 1;
            if (currentStep < 0) currentStep = 0;
            showStep(currentStep);
        }

        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                const output = document.getElementById('imagePreview');
                output.src = reader.result;
                output.style.display = 'block';
            };
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}
