@model PainelAdmin.Models.Pet

@{
    ViewData["Title"] = "Editar Pet";
    Layout = "_Painel";
}

<h1>Editar Pet</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="imagemAtual" value="@Model.Foto" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Idade" class="control-label"></label>
                <input asp-for="Idade" class="form-control" />
                <span asp-validation-for="Idade" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Especie" class="control-label"></label>
                <input asp-for="Especie" class="form-control" />
                <span asp-validation-for="Especie" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Porte" class="control-label"></label>
                <select asp-for="Porte" class="form-control">
                    <option value="">Selecione</option>
                    <option>Pequeno</option>
                    <option>Médio</option>
                    <option>Grande</option>
                </select>
                <span asp-validation-for="Porte" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Raca" class="control-label"></label>
                <input asp-for="Raca" class="form-control" />
                <span asp-validation-for="Raca" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Cor" class="control-label"></label>
                <input asp-for="Cor" class="form-control" />
                <span asp-validation-for="Cor" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Sexo" class="control-label"></label>
                <select asp-for="Sexo" class="form-control">
                    <option value="">Selecione</option>
                    <option>Macho</option>
                    <option>Fêmea</option>
                </select>
                <span asp-validation-for="Sexo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="Situacao">Situação</label>
                <select id="Situacao" name="Situacao" class="form-control" onchange="mostrarTutor()">
                    <option value="">Selecione</option>
                    @if (Model.Situacao == "Adocao")
                    {
                        <option value="Adocao" selected="selected">Adoção</option>
                    }
                    else
                    {
                        <option value="Adocao">Adoção</option>
                    }

                    @if (Model.Situacao == "ComTutor")
                    {
                        <option value="ComTutor" selected="selected">Com Tutor</option>
                    }
                    else
                    {
                        <option value="ComTutor">Com Tutor</option>
                    }
                </select>
            </div>

            <div class="form-group" id="divTutor" style="display:@(Model.Situacao == "ComTutor" ? "block" : "none")">
                <label for="IdPessoa">Selecionar Tutor (Nome - CPF)</label>
                <select id="IdPessoa" name="IdPessoa" class="form-control">
                    <option value="">Selecione um tutor</option>
                    @foreach (var usuario in ViewBag.Usuarios as List<SelectListItem>)
                    {
                        if (Model.IdPessoa == usuario.Value)
                        {
                            <option value="@usuario.Value" selected="selected">@usuario.Text</option>
                        }
                        else
                        {
                            <option value="@usuario.Value">@usuario.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="fw-bold">Nova imagem (opcional)</label>
                <input type="file" name="Imagem" class="form-control" accept="image/*" onchange="previewImage(event)" />
            </div>

            <div class="mb-3 mt-2">
                <img id="imagePreview" src="~/@Model.Foto" alt="Imagem atual" style="width: 100px; height: 100px; object-fit: cover;" />
            </div>

            <div class="form-group">
                <input type="submit" value="Salvar Alterações" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar para a lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('imagePreview');
                output.src = reader.result;
                output.style.display = 'block';
            };
            reader.readAsDataURL(event.target.files[0]);
        }

        function mostrarTutor() {
            var situacao = document.getElementById('Situacao').value;
            var divTutor = document.getElementById('divTutor');

            if (situacao === 'ComTutor') {
                divTutor.style.display = 'block';
            } else {
                divTutor.style.display = 'none';
                // Limpa o valor do Select2 quando ele for escondido
                // Só tenta limpar se o Select2 estiver de fato inicializado
                if ($('#IdPessoa').data('select2')) {
                    $('#IdPessoa').val(null).trigger('change');
                }
            }
        }

        $(document).ready(function () {
            // Verificações adicionais (úteis para depuração) - você pode remover depois que tudo funcionar
            if (typeof jQuery == 'undefined') {
                console.error('ERRO: jQuery não foi carregado. Verifique a ordem dos scripts no _Layout.cshtml.');
                return; // Impede a execução se jQuery não estiver pronto
            }
            if (typeof $.fn.select2 == 'undefined') {
                console.error('ERRO: Select2 não foi carregado. Verifique a ordem dos scripts no _Layout.cshtml e o caminho.');
                return; // Impede a execução se Select2 não estiver pronto
            }

            // Inicializa o Select2 para o #IdPessoa
            $('#IdPessoa').select2({
                placeholder: "Digite nome ou CPF...",
                allowClear: true,
                width: 'resolve', // Garante que o Select2 se ajuste à largura do elemento pai
                minimumInputLength: 0 // Permite buscar sem digitar nada (se quiser exigir digitação, mude para 1 ou mais)
            });
            mostrarTutor();
            $('#Situacao').on('change', mostrarTutor);
        });
    </script>
}