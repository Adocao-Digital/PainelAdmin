@model IEnumerable<PainelAdmin.Models.Pet>

@{
    ViewData["Title"] = "Meus Pets";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

@section Styles {
    <link rel="stylesheet" href="~/css/site/meuspets.css" asp-append-version="true" />
}

<h1 class="mb-4 titulo-meus-pets text-center">Meus Pets</h1>


<p class="text-end mb-3">
    <a class="btn btn-success" asp-action="CadastroPet">Adicionar Pet</a>
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card-pet">
                @if (!string.IsNullOrEmpty(item.Foto))
                {
                    <img src="~/@item.Foto" alt="@item.Nome" class="pet-img mb-3" />
                }
                <h5>@item.Nome</h5>
                <p><strong>Espécie:</strong> @item.Especie</p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a class="btn btn-outline-secondary btn-icon" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                        <img src="~/img/editar-arquivo.png" alt="Editar" />
                    </a>
                    <button class="btn btn-outline-secondary btn-icon" data-bs-toggle="modal" data-bs-target="#modal-@item.Id" title="Visualizar">
                        <img src="~/img/olho.png" alt="Visualizar" />
                    </button>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-icon" title="Excluir" onclick="return confirm('Tem certeza que deseja excluir o pet @item.Nome?')">
                            <img src="~/img/lixeira-xmark.png" alt="Excluir" />
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal de Visualização -->
        <div class="modal fade" id="modal-@item.Id" tabindex="-1" aria-labelledby="modalLabel-@item.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalLabel-@item.Id">Visualizar Animal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Nome:</strong> @item.Nome</p>
                                <p><strong>Idade:</strong> @item.Idade</p>
                                <p><strong>Espécie:</strong> @item.Especie</p>
                                <p><strong>Porte:</strong> @item.Porte</p>
                                <p><strong>Raça:</strong> @item.Raca</p>
                                <p><strong>Cor:</strong> @item.Cor</p>
                                <p><strong>Sexo:</strong> @item.Sexo</p>
                                <p><strong>Situação:</strong> @item.Situacao</p>
                            </div>
                            <div class="col-md-6 text-center">
                                @if (!string.IsNullOrEmpty(item.Foto))
                                {
                                    <img src="~/@item.Foto" style="width: 200px; height: 200px; object-fit: cover;" class="rounded" />
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
