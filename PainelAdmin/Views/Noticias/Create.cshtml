@model PainelAdmin.Models.ViewModels.CriarNoticiaViewModel

@{
    ViewData["Title"] = "Nova Notícia";
}

<link rel="stylesheet" href="~/css/noticia.css" />

<div class="conteudo">
    <div class="topo">
        <h1>Nova notícia</h1>
        <a class="voltar" href="/Noticias/NoticiasAntigas">← Voltar</a>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" class="form-noticia">
        <div class="form-group">
            <label asp-for="Titulo">Título</label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Conteudo">Texto</label>
            <textarea asp-for="Conteudo" class="form-control textarea-grande"></textarea>
            <span asp-validation-for="Conteudo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Foto">Imagem</label>
            <div class="custom-file-upload">
                <label for="fotoUpload" class="upload-label">Escolher imagem</label>
                <span id="nomeArquivo" class="upload-filename">Nenhum arquivo selecionado</span>
                <input asp-for="Foto" type="file" id="fotoUpload" onchange="previewImage(event)" />
            </div>
            <span asp-validation-for="Foto" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Pré-visualização</label>
            <div class="preview-container">
                <img id="imagePreview" src="#" alt="Imagem Preview" style="display:none;" />
            </div>
        </div>

        <div class="form-group">
            <button type="submit" class="btn-salvar">Salvar</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
    function previewImage(event) {
        const fileInput = event.target;
        const fileName = fileInput.files[0]?.name || "Nenhum arquivo selecionado";
        document.getElementById('nomeArquivo').innerText = fileName;

        const reader = new FileReader();
        reader.onload = function () {
            const output = document.getElementById('imagePreview');
            output.src = reader.result;
            output.style.display = 'block';
        };
        if (fileInput.files[0]) {
            reader.readAsDataURL(fileInput.files[0]);
        }
    }
</script>
