@model PainelAdmin.Models.ApplicationUser

@{
    ViewData["Title"] = "Meu Perfil";
    Layout = "_Layout";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@section Styles {
    <link rel="stylesheet" href="~/css/site/perfil.css" asp-append-version="true" />
}

<div class="perfil-container mt-4">
    <div class="perfil-card">
        <div class="perfil-img">
            <img src="@Model.Foto" alt="Foto de perfil" />
        </div>

        <div class="perfil-info">
            <h2>@Model.Nome</h2>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>CPF:</strong> @Model.CPF</p>
            <p><strong>Sexo:</strong> @Model.Sexo</p>
            <p><strong>Data de Nascimento:</strong> @Model.DataNascimento.ToString("dd/MM/yyyy")</p>
            <p><strong>Status:</strong> @(Model.Ativo ? "Ativo" : "Inativo")</p>

            @if (Model.Endereco != null)
            {
                <hr />
                <p><strong>Endereço:</strong> @Model.Endereco.Rua, @Model.Endereco.Numero - @Model.Endereco.Bairro</p>
                <p><strong>Cidade/Estado:</strong> @Model.Endereco.Cidade / @Model.Endereco.Estado</p>
                <p><strong>CEP:</strong> @Model.Endereco.CEP</p>
            }

            <a asp-action="EditarPerfil" asp-controller="Account" class="btn-editar">Editar Perfil</a>
        </div>
    </div>
</div>
