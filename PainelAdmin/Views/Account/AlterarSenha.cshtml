@model PainelAdmin.Models.ViewModels.AlterarSenhaViewModel

@{
    ViewData["Title"] = "Alterar Senha";
    Layout = "_Layout";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@section Styles {
    <link rel="stylesheet" href="~/css/site/alterar-senha.css" asp-append-version="true" />
}

<div class="senha-container mt-4">
    <div class="senha-card">
        <h2 class="titulo-form">Alterar Senha</h2>

        <form asp-action="AlterarSenha" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="campo">
                <label asp-for="SenhaAtual"></label>
                <input asp-for="SenhaAtual" type="password" class="form-control" />
                <span asp-validation-for="SenhaAtual" class="text-danger"></span>
            </div>

            <div class="campo">
                <label asp-for="NovaSenha"></label>
                <input asp-for="NovaSenha" type="password" class="form-control" />
                <span asp-validation-for="NovaSenha" class="text-danger"></span>
            </div>

            <div class="campo">
                <label asp-for="ConfirmacaoSenha"></label>
                <input asp-for="ConfirmacaoSenha" type="password" class="form-control" />
                <span asp-validation-for="ConfirmacaoSenha" class="text-danger"></span>
            </div>

            <div class="text-end mb-3">
                <button type="submit" class="btn btn-success">Alterar Senha</button>
                <a asp-action="Perfil" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
