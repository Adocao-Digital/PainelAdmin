@model PainelAdmin.Models.ViewModels.UsuarioEditarViewModel

@{
    ViewData["Title"] = "Editar Perfil";
    Layout = "_Layout";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@section Styles {
    <link rel="stylesheet" href="~/css/site/editar-perfil.css" asp-append-version="true" />
}

<div class="editar-perfil-container mt-4">
    <div class="perfil-card">
        <h2 class="titulo-form">Editar Perfil</h2>

        <form asp-action="EditarPerfil" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="campo">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="campo">
                <label asp-for="CPF"></label>
                <input asp-for="CPF" class="form-control" />
                <span asp-validation-for="CPF" class="text-danger"></span>
            </div>

            <div class="campo">
                <label asp-for="Sexo"></label>
                <select asp-for="Sexo" class="form-select">
                    <option value="">Selecione</option>
                    <option>Masculino</option>
                    <option>Feminino</option>
                </select>
            </div>

            <div class="campo">
                <label asp-for="DataNascimento"></label>
                <input asp-for="DataNascimento" type="date" class="form-control" />
            </div>

            <hr />
            <h4 class="subtitulo">Endereço</h4>

            <div class="campo">
                <label asp-for="Rua"></label>
                <input asp-for="Rua" class="form-control" />
            </div>

            <div class="campo">
                <label asp-for="Numero"></label>
                <input asp-for="Numero" class="form-control" />
            </div>

            <div class="campo">
                <label asp-for="Bairro"></label>
                <input asp-for="Bairro" class="form-control" />
            </div>

            <div class="campo">
                <label asp-for="Cidade"></label>
                <input asp-for="Cidade" class="form-control" />
            </div>

            <div class="campo">
                <label asp-for="Estado"></label>
                <input asp-for="Estado" class="form-control" />
            </div>

            <div class="campo">
                <label asp-for="CEP"></label>
                <input asp-for="CEP" class="form-control" />
            </div>

            <hr />
            <h4 class="subtitulo">Foto de Perfil</h4>

            @if (!string.IsNullOrEmpty(Model.FotoAtual))
            {
                <div class="foto-atual">
                    <img src="@Model.FotoAtual" alt="Foto atual" />
                </div>
            }

            <div class="campo">
                <label asp-for="FotoUpload"></label>
                <input asp-for="FotoUpload" type="file" class="form-control" />
            </div>

            <div class="text-end mb-3">
                <button type="submit" class="btn btn-success">Salvar Alterações</button>
                <a asp-action="Perfil" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
